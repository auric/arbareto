{
  "productName": "Arbareto",
  "mainBinaryName": "arbareto",
  "identifier": "io.github.auric.arbareto",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "style-src": "'self'",
        "style-src-elem": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "connect-src": "ipc: http://ipc.localhost 'self'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "targets": ["nsis"],
    "publisher": "Ihor Lifanov",
    "copyright": "Copyright (c) 2026 Ihor Lifanov",
    "icon": ["icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "skip" },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer-hooks.nsh"
      }
    }
  }
}
