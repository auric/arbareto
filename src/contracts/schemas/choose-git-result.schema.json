{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "gitInstallationId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "selectedPath": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "executablePath": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "version": {
          "type": "string"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "gitInstallationId",
        "selectedPath",
        "executablePath",
        "version",
        "digest"
      ],
      "additionalProperties": false,
      "title": "ChooseGitSelected"
    },
    {
      "type": "object",
      "properties": {
        "detectedVersion": {
          "type": "string"
        },
        "reason": {
          "type": "string",
          "enum": [
            "selected-missing",
            "resolution-failed",
            "resolved-missing",
            "outside-installation"
          ]
        },
        "path": {
          "type": "string"
        },
        "minimumVersion": {
          "type": "string"
        }
      },
      "required": [
        "minimumVersion"
      ],
      "additionalProperties": false,
      "title": "ChooseGitFailed"
    }
  ],
  "title": "ChooseGitResult"
}
