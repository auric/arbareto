{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "sessionId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "sessionId"
      ],
      "additionalProperties": false,
      "title": "HandshakeAccepted"
    },
    {
      "type": "object",
      "properties": {
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "PROTOCOL_VERSION"
          ]
        }
      },
      "required": [
        "code"
      ],
      "additionalProperties": false,
      "title": "HandshakeRefused"
    }
  ],
  "title": "HandshakeReply"
}
