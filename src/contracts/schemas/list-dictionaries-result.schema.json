{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "languages": {
      "maxItems": 92,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "state": {
            "type": "string",
            "enum": [
              "not-downloaded",
              "ready",
              "changed",
              "downloading",
              "importing"
            ]
          },
          "notice": {
            "type": "string",
            "enum": [
              "catalog-changed"
            ]
          }
        },
        "required": [
          "language",
          "state"
        ],
        "additionalProperties": false,
        "title": "DictionaryLanguage"
      }
    },
    "removed": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "language": {
            "type": "string",
            "maxLength": 32,
            "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
          },
          "name": {
            "type": "string",
            "pattern": "^[^\\u0000]*$"
          }
        },
        "required": [
          "language",
          "name"
        ],
        "additionalProperties": false,
        "title": "RemovedLanguage"
      }
    }
  },
  "required": [
    "languages",
    "removed"
  ],
  "additionalProperties": false,
  "title": "ListDictionariesResult"
}
