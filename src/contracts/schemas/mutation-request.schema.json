{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "started"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "operationId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "repositoryId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "applyHunk",
            "applyFile",
            "commit",
            "updateSubmodules",
            "sync",
            "workbench",
            "applyFiles"
          ]
        },
        "direction": {
          "type": "string",
          "enum": [
            "stage",
            "unstage",
            "resolve"
          ]
        },
        "action": {
          "type": "string",
          "enum": [
            "fetch",
            "fetch-all",
            "pull",
            "integrate",
            "push",
            "force-push",
            "abort",
            "continue",
            "skip",
            "switch",
            "create-branch",
            "rename-branch",
            "delete-branch",
            "merge",
            "rebase",
            "choose-ours",
            "choose-theirs",
            "mergetool",
            "ignore-gitignore",
            "ignore-exclude",
            "worktree-add",
            "worktree-remove",
            "worktree-prune",
            "config-save",
            "delete-files",
            "ignore-save-gitignore",
            "ignore-save-exclude"
          ]
        },
        "worktreeRoot": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "commonDirectory": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": [
        "type",
        "callId",
        "operationId",
        "repositoryId",
        "kind",
        "worktreeRoot",
        "commonDirectory"
      ],
      "additionalProperties": false,
      "title": "Started"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "ended"
        },
        "operationId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "endProcesses": {
          "type": "boolean"
        }
      },
      "required": [
        "type",
        "operationId",
        "endProcesses"
      ],
      "additionalProperties": false,
      "title": "Ended"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resolved"
        },
        "markerId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "markerId"
      ],
      "additionalProperties": false,
      "title": "Resolved"
    }
  ],
  "title": "MutationRequest"
}
