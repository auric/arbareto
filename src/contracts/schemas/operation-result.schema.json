{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "operationId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operation": {
      "type": "string",
      "enum": [
        "getEnvironment",
        "chooseGit",
        "chooseRepository",
        "restoreWorkspace",
        "readWorkspace",
        "readEntries",
        "readHistory",
        "readComparison",
        "readTrust",
        "approveTrust",
        "revokeTrust",
        "applyHunk",
        "applyFile",
        "reviewCommit",
        "commit",
        "reviewSubmodules",
        "updateSubmodules",
        "cancel",
        "getOperation",
        "requestClose",
        "currentSession",
        "dismissRecoveryMarker"
      ]
    },
    "state": {
      "type": "string",
      "enum": [
        "accepted",
        "running",
        "cancel-requested",
        "reconciling",
        "succeeded",
        "limited",
        "failed",
        "canceled",
        "completed-with-effects",
        "failed-with-effects",
        "unknown",
        "rejected"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "wsl-starting",
        "preflight",
        "candidate-verification",
        "publication",
        "commit-handoff",
        "submodule-confirmation",
        "fetch",
        "update",
        "reconciliation"
      ]
    },
    "code": {
      "type": "string",
      "enum": [
        "INVALID_REQUEST",
        "PROTOCOL_VERSION",
        "UNKNOWN_OPERATION",
        "UNKNOWN_TARGET",
        "FRAME_LIMIT",
        "BUSY",
        "WORKSPACE_LIMIT",
        "GIT_UNAVAILABLE",
        "GIT_CHANGED",
        "GIT_UNSUPPORTED",
        "WEBVIEW_UNAVAILABLE",
        "WEBVIEW_UNSUPPORTED",
        "WSL_UNAVAILABLE",
        "REPOSITORY_UNAVAILABLE",
        "REPOSITORY_CHANGED",
        "UNSUPPORTED_REPOSITORY",
        "OPERATION_IN_PROGRESS",
        "CONFLICTED",
        "LOCKED",
        "UNSUPPORTED_SUBMODULE",
        "TRUST_REQUIRED",
        "TRUST_CHANGED",
        "STALE_SELECTION",
        "STALE_REVIEW",
        "APPROVAL_EXPIRED",
        "UNSUPPORTED_HUNK_PROFILE",
        "MALFORMED_GIT_OUTPUT",
        "OUTPUT_LIMIT",
        "OBJECT_MISSING",
        "UNSUPPORTED_COMPARISON",
        "DISPLAY_MAPPING_FAILED",
        "GRAPH_LAYOUT_LIMITED",
        "WORKTREE_CHANGING",
        "IDENTITY_REQUIRED",
        "HOOK_FAILED",
        "SIGNING_FAILED",
        "GIT_FAILED",
        "PROCESS_OWNERSHIP_FAILED",
        "DEADLINE",
        "CANCELED",
        "COMMIT_ENCODING_UNSUPPORTED",
        "COMPLETED_WITH_EFFECTS",
        "FAILED_WITH_EFFECTS",
        "STATE_UNKNOWN",
        "SERVICE_UNAVAILABLE",
        "RECOVERY_MARKER_FAILED"
      ]
    },
    "cause": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "stalled": {
      "type": "boolean"
    },
    "endProcesses": {
      "type": "boolean"
    },
    "lingering": {
      "type": "boolean"
    },
    "lingeringDescendants": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rowId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    }
  },
  "required": [
    "operationId",
    "operation",
    "state"
  ],
  "additionalProperties": false,
  "title": "OperationResult"
}
