{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "output"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "stream": {
          "type": "string",
          "enum": [
            "stdout",
            "stderr"
          ]
        },
        "data": {
          "type": "string",
          "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$"
        }
      },
      "required": [
        "type",
        "callId",
        "stream",
        "data"
      ],
      "additionalProperties": false,
      "title": "Output"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "activity"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "state": {
          "type": "string",
          "enum": [
            "stalled",
            "active"
          ]
        }
      },
      "required": [
        "type",
        "callId",
        "state"
      ],
      "additionalProperties": false,
      "title": "Activity"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "inputWritten"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "callId"
      ],
      "additionalProperties": false,
      "title": "InputWritten"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "exit"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "exitCode": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0,
              "maximum": 4294967295
            },
            {
              "type": "null"
            }
          ]
        },
        "activeDescendants": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "deadline": {
          "type": "string",
          "enum": [
            "deadline",
            "inactivity",
            "ceiling"
          ]
        }
      },
      "required": [
        "type",
        "callId",
        "exitCode",
        "activeDescendants"
      ],
      "additionalProperties": false,
      "title": "Exit"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "refused"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "code": {
          "type": "string",
          "enum": [
            "INVALID_REQUEST",
            "UNKNOWN_TARGET",
            "GIT_CHANGED",
            "PROCESS_OWNERSHIP_FAILED"
          ]
        }
      },
      "required": [
        "type",
        "callId",
        "code"
      ],
      "additionalProperties": false,
      "title": "Refused"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "identity"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "identities": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "volumeSerial": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{16}$"
                  },
                  "fileId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{32}$"
                  }
                },
                "required": [
                  "volumeSerial",
                  "fileId"
                ],
                "additionalProperties": false,
                "title": "FileIdentity"
              },
              {
                "type": "object",
                "properties": {
                  "code": {
                    "type": "string",
                    "const": "UNSUPPORTED_REPOSITORY"
                  }
                },
                "required": [
                  "code"
                ],
                "additionalProperties": false,
                "title": "IdentityRefused"
              }
            ]
          }
        }
      },
      "required": [
        "type",
        "callId",
        "identities"
      ],
      "additionalProperties": false,
      "title": "IdentityList"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "lingeringCount"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "type",
        "callId",
        "count"
      ],
      "additionalProperties": false,
      "title": "LingeringCountReply"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "register"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "result": {
          "type": "string",
          "enum": [
            "approved",
            "declined"
          ]
        }
      },
      "required": [
        "type",
        "callId",
        "result"
      ],
      "additionalProperties": false,
      "title": "RegisterResult"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "register"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "result": {
          "type": "string",
          "const": "another"
        },
        "bootstrapId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "executablePath": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": [
        "type",
        "callId",
        "result",
        "bootstrapId",
        "executablePath"
      ],
      "additionalProperties": false,
      "title": "RegisterAnother"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "resolveGit"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "bootstrapId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "callId",
        "bootstrapId"
      ],
      "additionalProperties": false,
      "title": "ResolveGitReply"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "fileFacts"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "facts": {
          "minItems": 1,
          "maxItems": 64,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "file"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "lastWrite": {
                    "type": "string",
                    "pattern": "^(?:0|-?[1-9][0-9]{0,18})$"
                  },
                  "digest": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  },
                  "bound": {
                    "type": "string",
                    "enum": [
                      "file-bytes",
                      "total-bytes"
                    ]
                  },
                  "executable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "size",
                  "lastWrite"
                ],
                "additionalProperties": false,
                "title": "FileFactFile"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "directory"
                  },
                  "executable": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false,
                "title": "FileFactDirectory"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "link"
                  },
                  "component": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "tag": {
                    "type": "string",
                    "enum": [
                      "symlink",
                      "junction",
                      "other"
                    ]
                  },
                  "target": {
                    "type": "string",
                    "pattern": "^[^\\u0000]*$"
                  },
                  "relative": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "kind",
                  "component",
                  "tag"
                ],
                "additionalProperties": false,
                "title": "FileFactLink"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "absent"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false,
                "title": "FileFactAbsent"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "other"
                  }
                },
                "required": [
                  "kind"
                ],
                "additionalProperties": false,
                "title": "FileFactOther"
              },
              {
                "type": "object",
                "properties": {
                  "kind": {
                    "type": "string",
                    "const": "error"
                  },
                  "component": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 9007199254740991
                  },
                  "code": {
                    "type": "string",
                    "enum": [
                      "access-denied",
                      "sharing-violation",
                      "io-error",
                      "other-error"
                    ]
                  }
                },
                "required": [
                  "kind",
                  "component",
                  "code"
                ],
                "additionalProperties": false,
                "title": "FileFactError"
              }
            ]
          }
        }
      },
      "required": [
        "type",
        "callId",
        "facts"
      ],
      "additionalProperties": false,
      "title": "FileFactsReply"
    }
  ],
  "title": "ProcessReply"
}
