{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operationId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "accepted",
        "running",
        "cancel-requested",
        "reconciling"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "wsl-starting",
        "preflight",
        "candidate-verification",
        "publication",
        "commit-handoff",
        "submodule-confirmation",
        "fetch",
        "update",
        "reconciliation"
      ]
    },
    "counters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "stalled": {
      "type": "boolean"
    }
  },
  "required": [
    "requestId",
    "operationId",
    "state",
    "counters"
  ],
  "additionalProperties": false,
  "title": "Progress"
}
