{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "requestId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "operationId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "state": {
      "type": "string",
      "enum": [
        "accepted",
        "running",
        "cancel-requested",
        "reconciling"
      ]
    },
    "phase": {
      "type": "string",
      "enum": [
        "wsl-starting",
        "preflight",
        "candidate-verification",
        "publication",
        "commit-handoff",
        "submodule-confirmation",
        "fetch",
        "update",
        "reconciliation",
        "history-load",
        "history-search",
        "sync-fetch",
        "sync-merge",
        "sync-rebase",
        "sync-push",
        "sync-continue",
        "clone",
        "pageant",
        "switch-stash",
        "switch-checkout",
        "switch-reapply",
        "switch-drop",
        "branch",
        "merge",
        "rebase",
        "resolve",
        "mergetool",
        "worktree",
        "config",
        "stage-files",
        "blame",
        "delete-files",
        "ignore-save",
        "preview"
      ]
    },
    "counters": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "stalled": {
      "type": "boolean"
    },
    "path": {
      "type": "string",
      "pattern": "^[^\\u0000]*$"
    },
    "distro": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
    }
  },
  "required": [
    "requestId",
    "operationId",
    "state",
    "counters"
  ],
  "additionalProperties": false,
  "title": "Progress"
}
