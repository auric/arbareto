{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "changesId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "viewId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "oid": {
          "type": "string",
          "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
        },
        "parents": {
          "maxItems": 64,
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
          }
        },
        "base": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "parent"
                },
                "index": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 63
                },
                "oid": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              },
              "required": [
                "kind",
                "index",
                "oid"
              ],
              "additionalProperties": false,
              "title": "ParentBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "empty-tree"
                },
                "oid": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              },
              "required": [
                "kind",
                "oid"
              ],
              "additionalProperties": false,
              "title": "EmptyTreeBase"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "shallow"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false,
              "title": "ShallowBase"
            }
          ],
          "title": "CommitBase"
        },
        "files": {
          "maxItems": 100000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "fileId": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "status": {
                "type": "string",
                "enum": [
                  "added",
                  "deleted",
                  "modified",
                  "renamed",
                  "type-changed"
                ]
              },
              "score": {
                "type": "integer",
                "minimum": 0,
                "maximum": 100
              },
              "pathBytes": {
                "type": "string",
                "minLength": 1,
                "format": "base64",
                "contentEncoding": "base64",
                "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
              },
              "oldPathBytes": {
                "type": "string",
                "minLength": 1,
                "format": "base64",
                "contentEncoding": "base64",
                "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "file",
                  "link",
                  "submodule"
                ]
              }
            },
            "required": [
              "fileId",
              "status",
              "pathBytes",
              "kind"
            ],
            "additionalProperties": false,
            "title": "CommitChangeEntry"
          }
        },
        "completeness": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "complete"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false,
              "title": "ChangesComplete"
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "limited"
                },
                "code": {
                  "type": "string",
                  "const": "OUTPUT_LIMIT"
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "STATUS_LISTING_RECORDS",
                    "STATUS_LISTING_BYTES",
                    "COMMIT_CHANGES_RESULT_BYTES"
                  ]
                },
                "shown": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "state",
                "code",
                "reason",
                "shown"
              ],
              "additionalProperties": false,
              "title": "ChangesLimited"
            }
          ],
          "title": "ChangesCompleteness"
        }
      },
      "required": [
        "changesId",
        "viewId",
        "oid",
        "parents",
        "base",
        "files",
        "completeness"
      ],
      "additionalProperties": false,
      "title": "CommitChanges"
    },
    {
      "type": "object",
      "properties": {
        "remedy": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "remedy"
      ],
      "additionalProperties": false,
      "title": "InspectionObjectMissing"
    }
  ],
  "title": "ReadCommitChangesResult"
}
