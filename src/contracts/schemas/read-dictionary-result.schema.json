{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "file": {
          "type": "string",
          "enum": [
            "index.aff",
            "index.dic",
            "license",
            "licence",
            "readme.md"
          ]
        },
        "size": {
          "type": "integer",
          "minimum": 1,
          "maximum": 12582912
        },
        "offset": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991,
          "multipleOf": 1048576
        },
        "bytes": {
          "type": "string",
          "maxLength": 1398104,
          "format": "base64",
          "contentEncoding": "base64",
          "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
        }
      },
      "required": [
        "language",
        "file",
        "size",
        "offset",
        "bytes"
      ],
      "additionalProperties": false,
      "title": "DictionaryChunk"
    },
    {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "absent",
            "changed"
          ]
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "folder": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false,
      "title": "ReadDictionaryRefusal"
    }
  ],
  "title": "ReadDictionaryResult"
}
