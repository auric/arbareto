{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "pathBytes": {
          "type": "string",
          "minLength": 1,
          "format": "base64",
          "contentEncoding": "base64",
          "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
        },
        "path": {
          "type": "string"
        },
        "kind": {
          "type": "string",
          "enum": [
            "submodule",
            "nested"
          ]
        },
        "old": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "new": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "state": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "commits"
                },
                "added": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "removed": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "addedCommits": {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "oid": {
                        "type": "string",
                        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                      },
                      "subject": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "oid",
                      "subject"
                    ],
                    "additionalProperties": false,
                    "title": "SubmoduleCommit"
                  }
                },
                "removedCommits": {
                  "maxItems": 50,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "oid": {
                        "type": "string",
                        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                      },
                      "subject": {
                        "type": "string"
                      }
                    },
                    "required": [
                      "oid",
                      "subject"
                    ],
                    "additionalProperties": false,
                    "title": "SubmoduleCommit"
                  }
                }
              },
              "required": [
                "state",
                "added",
                "removed",
                "addedCommits",
                "removedCommits"
              ],
              "additionalProperties": false,
              "title": "SubmoduleCommitsState"
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "missing"
                },
                "which": {
                  "type": "string",
                  "enum": [
                    "old",
                    "new",
                    "both"
                  ]
                }
              },
              "required": [
                "state",
                "which"
              ],
              "additionalProperties": false,
              "title": "SubmoduleMissingState"
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "not-initialized"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false,
              "title": "SubmoduleNotInitializedState"
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "single"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false,
              "title": "SubmoduleSingleState"
            }
          ]
        },
        "limited": {
          "type": "boolean"
        }
      },
      "required": [
        "pathBytes",
        "path",
        "kind",
        "old",
        "new",
        "state",
        "limited"
      ],
      "additionalProperties": false,
      "title": "SubmoduleChange"
    },
    {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "path"
          ]
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false,
      "title": "SubmoduleChangeRefused"
    }
  ],
  "title": "ReadSubmoduleChangeResult"
}
