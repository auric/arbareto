{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "state": {
          "type": "string",
          "enum": [
            "untrusted",
            "approved",
            "changed",
            "revoked"
          ]
        },
        "persistence": {
          "type": "string",
          "enum": [
            "stored",
            "session"
          ]
        },
        "trustId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "approvalRequired": {
          "type": "object",
          "properties": {
            "reads": {
              "type": "boolean"
            },
            "commit": {
              "type": "boolean"
            },
            "sync": {
              "type": "boolean"
            },
            "workbench": {
              "type": "boolean"
            }
          },
          "required": [
            "reads",
            "commit",
            "sync",
            "workbench"
          ],
          "additionalProperties": false
        },
        "inputLimited": {
          "type": "boolean",
          "const": true
        },
        "entries": {
          "maxItems": 4096,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "key": {
                "type": "string",
                "minLength": 1
              },
              "scope": {
                "type": "string",
                "enum": [
                  "system",
                  "global",
                  "local",
                  "worktree",
                  "command",
                  "submodule",
                  "unknown"
                ]
              },
              "origin": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "key",
              "scope",
              "origin"
            ],
            "additionalProperties": false,
            "title": "TrustEntry"
          }
        },
        "hooks": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string",
                    "minLength": 1
                  },
                  "name": {
                    "type": "string"
                  },
                  "scope": {
                    "type": "string",
                    "enum": [
                      "system",
                      "global",
                      "local",
                      "worktree",
                      "command",
                      "submodule",
                      "unknown"
                    ]
                  },
                  "commandScope": {
                    "type": "string",
                    "enum": [
                      "system",
                      "global",
                      "local",
                      "worktree",
                      "command",
                      "submodule",
                      "unknown"
                    ]
                  },
                  "commandOrigin": {
                    "type": "string"
                  },
                  "disabled": {
                    "type": "boolean"
                  },
                  "repositoryControlled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "event",
                  "name",
                  "scope",
                  "disabled",
                  "repositoryControlled"
                ],
                "additionalProperties": false,
                "title": "ConfiguredHook"
              },
              {
                "type": "object",
                "properties": {
                  "event": {
                    "type": "string",
                    "minLength": 1
                  },
                  "path": {
                    "type": "string",
                    "minLength": 1
                  },
                  "repositoryControlled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "event",
                  "path",
                  "repositoryControlled"
                ],
                "additionalProperties": false,
                "title": "FolderHook"
              }
            ]
          }
        },
        "programs": {
          "type": "object",
          "properties": {
            "hooks": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "event": {
                            "type": "string",
                            "pattern": "^[^\\u0000]*$"
                          },
                          "folder": {
                            "type": "string",
                            "pattern": "^[^\\u0000]*$"
                          }
                        },
                        "required": [
                          "event",
                          "folder"
                        ],
                        "additionalProperties": false,
                        "title": "FolderHookName"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "event": {
                            "type": "string",
                            "pattern": "^[^\\u0000]*$"
                          },
                          "scope": {
                            "type": "string",
                            "enum": [
                              "system",
                              "global",
                              "local",
                              "worktree",
                              "command",
                              "submodule",
                              "unknown"
                            ]
                          }
                        },
                        "required": [
                          "event",
                          "scope"
                        ],
                        "additionalProperties": false,
                        "title": "ConfiguredHookName"
                      }
                    ]
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "filters": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "driver": {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "driver",
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "monitors": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "mergeDrivers": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "driver": {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "driver",
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "mergeTools": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "tool",
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "signing": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "other": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hooks",
            "filters",
            "monitors",
            "mergeDrivers",
            "mergeTools",
            "signing",
            "other"
          ],
          "additionalProperties": false,
          "title": "TrustDetails"
        }
      },
      "required": [
        "generation",
        "state",
        "persistence",
        "approvalRequired",
        "entries",
        "hooks",
        "programs"
      ],
      "additionalProperties": false,
      "title": "TrustReport"
    },
    {
      "type": "object",
      "properties": {
        "remedy": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "text"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "remedy"
      ],
      "additionalProperties": false,
      "title": "TrustListingFailed"
    },
    {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "TRUST_REPORT_ENTRIES",
            "TRUST_REPORT_HOOKS"
          ]
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false,
      "title": "TrustReportLimited"
    }
  ],
  "title": "ReadTrustResult"
}
