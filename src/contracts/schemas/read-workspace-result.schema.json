{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "snapshotId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "identity": {
          "type": "object",
          "properties": {
            "worktreeRoot": {
              "type": "string",
              "maxLength": 32767,
              "pattern": "^[^\\u0000]*$"
            },
            "gitDirectory": {
              "type": "string",
              "maxLength": 32767,
              "pattern": "^[^\\u0000]*$"
            },
            "commonDirectory": {
              "type": "string",
              "maxLength": 32767,
              "pattern": "^[^\\u0000]*$"
            },
            "indexPath": {
              "type": "string",
              "maxLength": 32767,
              "pattern": "^[^\\u0000]*$"
            },
            "objectFormat": {
              "type": "string",
              "enum": [
                "sha1",
                "sha256"
              ]
            },
            "refFormat": {
              "type": "string",
              "enum": [
                "files",
                "reftable"
              ]
            }
          },
          "required": [
            "worktreeRoot",
            "gitDirectory",
            "commonDirectory",
            "indexPath",
            "objectFormat",
            "refFormat"
          ],
          "additionalProperties": false
        },
        "head": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "branch"
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "oid": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              },
              "required": [
                "state",
                "target",
                "oid"
              ],
              "additionalProperties": false,
              "title": "BranchHead"
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "detached"
                },
                "oid": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              },
              "required": [
                "state",
                "oid"
              ],
              "additionalProperties": false,
              "title": "DetachedHead"
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "unborn"
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "state",
                "target"
              ],
              "additionalProperties": false,
              "title": "UnbornHead"
            }
          ],
          "title": "Head"
        },
        "operationState": {
          "type": "string",
          "enum": [
            "normal",
            "conflicted",
            "merging",
            "rebasing",
            "cherry-picking",
            "reverting",
            "sequencer-active",
            "unknown"
          ]
        },
        "recoveryState": {
          "type": "string",
          "enum": [
            "ready",
            "refreshing",
            "reconciling",
            "unknown",
            "unavailable"
          ]
        },
        "completeness": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "complete"
                }
              },
              "required": [
                "state"
              ],
              "additionalProperties": false,
              "title": "Complete"
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "limited"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "OUTPUT_LIMIT",
                    "OBJECT_MISSING",
                    "WORKTREE_CHANGING"
                  ]
                },
                "reason": {
                  "type": "string",
                  "enum": [
                    "APPROVAL_LIFETIME_MS",
                    "ATTRIBUTION_EVIDENCE_BYTES",
                    "ATTRIBUTION_EVIDENCE_RECORDS",
                    "BLAME_FILE_BYTES",
                    "BLAME_FILE_LINES",
                    "BLAME_OUTPUT_BYTES",
                    "BLAME_PROGRESS_EVENTS_PER_SECOND",
                    "BLAME_RESULT_BYTES",
                    "BOOTSTRAP_DEADLINE_CAP_MS",
                    "CANONICAL_DIFF_BYTES",
                    "CANONICAL_DIFF_LINES",
                    "CHANNEL_PATH_UNITS",
                    "CLONE_URL_BYTES",
                    "CLOSE_CLEANUP_TARGET_MS",
                    "COMMIT_CHANGES_RESULT_BYTES",
                    "COMMIT_MESSAGE_BYTES",
                    "COMMIT_OUTPUT_TAIL_BYTES",
                    "COMMIT_OUTPUT_TAIL_LINES",
                    "COMMIT_PROCESS_DEADLINE_MS",
                    "COMPARED_NORMALIZED_VERSION_BYTES",
                    "COMPARED_RAW_VERSION_BYTES",
                    "CONCURRENT_READS_GLOBAL",
                    "CONCURRENT_READS_PER_WORKSPACE",
                    "DAMAGED_MARKERS_PER_HANDSHAKE",
                    "DAMAGED_MARKER_FILE_NAME_UNITS",
                    "DIAGNOSTIC_RETAINED_BYTES_PER_STREAM",
                    "DICTIONARY_CATALOG_ENTRIES",
                    "DICTIONARY_CHUNK_BYTES",
                    "DICTIONARY_DOWNLOAD_DEADLINE_MS",
                    "DICTIONARY_LANGUAGE_BYTES",
                    "DICTIONARY_LANGUAGE_MEMORY_BYTES",
                    "DICTIONARY_LOAD_DEADLINE_MS",
                    "DICTIONARY_LOAD_GATE_MS",
                    "DICTIONARY_MANIFEST_BYTES",
                    "DICTIONARY_PROGRESS_EVENTS_PER_SECOND",
                    "DISCARD_CHECK_PATHS",
                    "FILE_FACT_COMPONENT_UNITS",
                    "FILE_FACT_ENTRIES",
                    "FILTER_TEXT_BYTES",
                    "FINISHED_OPERATION_RECORDS",
                    "GIT_EXECUTABLE_DIGEST_BYTES",
                    "GIT_PROCESS_DEADLINE_MS",
                    "GRAPH_LANES",
                    "HISTORY_CHECKPOINT_ROWS",
                    "HISTORY_COMMIT_OBJECT_BYTES",
                    "HISTORY_LOAD_MARGIN",
                    "HISTORY_PAGE_BYTES",
                    "HISTORY_PARENTS_PER_COMMIT",
                    "HISTORY_PARENTS_PER_PAGE",
                    "HISTORY_PROCESSES_PER_VIEW",
                    "HISTORY_PROCESS_DEADLINE_MS",
                    "HISTORY_PROGRESS_EVENTS_PER_SECOND",
                    "HISTORY_RENDERER_CACHE_BYTES",
                    "HISTORY_ROWS_PER_REQUEST",
                    "HISTORY_TEXT_DEADLINE_MS",
                    "HISTORY_VIEWS_PER_SESSION",
                    "HISTORY_VIEW_COMMITS",
                    "IDENTIFIER_BYTES",
                    "IDENTITY_PATHS",
                    "IGNORE_TARGET_BYTES",
                    "INLINE_PROCESS_INPUT_BYTES",
                    "JSON_NESTING_LEVELS",
                    "KEY_FILE_ENTRIES",
                    "MERGE_MESSAGE_BYTES",
                    "MULTI_FILE_ACTION_BYTES",
                    "MULTI_FILE_ACTION_FILES",
                    "MULTI_FILE_ATTRIBUTE_BYTES",
                    "MULTI_FILE_PROOF_CONCURRENCY",
                    "MULTI_FILE_STEP_MS_PER_FILE",
                    "MUTATIONS_PER_COMMON_REPOSITORY",
                    "MUTATION_RAW_INDEX_BYTES",
                    "NATIVE_CHUNK_BYTES",
                    "PAGEANT_READY_MS",
                    "PENDING_READS_GLOBAL",
                    "PERSONAL_WORDS",
                    "PERSONAL_WORD_CODE_POINTS",
                    "PIPE_FRAME_BYTES",
                    "PREVIEW_GROUP_PATHS",
                    "PREVIEW_IGNORE_FILES",
                    "PREVIEW_PATHS",
                    "PROCESS_EXIT_CODE_MAX",
                    "PUBLIC_FRAME_BODY_BYTES",
                    "PUBLIC_REQUEST_BYTES",
                    "QUEUED_PIPE_CHUNKS_PER_STREAM",
                    "READ_DEADLINE_MS",
                    "RECONCILIATION_TARGET_MS",
                    "RECORDED_REQUEST_IDS",
                    "RECOVERY_MARKERS_PER_HANDSHAKE",
                    "RECOVERY_MARKER_BYTES",
                    "REFLOG_SCAN_ENTRIES",
                    "REF_LISTING_BYTES",
                    "REF_LISTING_RECORDS",
                    "REGISTERED_DEADLINE_CAP_MS",
                    "REGISTERED_WORKSPACES",
                    "REGISTER_VERSION_BYTES",
                    "RETAINED_COMPARISONS",
                    "RETAINED_COMPARISON_BYTES",
                    "SESSION_LOG_ENTRIES",
                    "SHALLOW_METADATA_BYTES",
                    "SPELLING_LANGUAGES",
                    "SPELLING_SUGGESTIONS",
                    "STALL_NOTICE_MS",
                    "STATUS_LISTING_BYTES",
                    "STATUS_LISTING_RECORDS",
                    "STATUS_PAGE_BYTES",
                    "STREAMED_PROCESS_INPUT_BYTES",
                    "SUBMODULE_GITMODULES_BYTES",
                    "SUBMODULE_PROGRESS_EVENTS_PER_SECOND",
                    "SUBMODULE_REVIEW_NESTING_LEVELS",
                    "SUBMODULE_REVIEW_SUBMODULES",
                    "SUBMODULE_UPDATE_CEILING_MS",
                    "SUBMODULE_UPDATE_INACTIVITY_MS",
                    "SYNC_FETCH_LISTED_REFS",
                    "SYNC_LEASE_COMMITS",
                    "SYNC_REBASE_TODO_BYTES",
                    "SYNC_REFS_BYTES",
                    "SYNC_REFS_RECORDS",
                    "SYNC_REMOTES",
                    "TRACKING_COUNT_DISPLAY",
                    "TRUST_DIGEST_FILES",
                    "TRUST_DIGEST_FILE_BYTES",
                    "TRUST_DIGEST_TOTAL_BYTES",
                    "TRUST_INPUT_BYTES",
                    "TRUST_LINK_HOPS",
                    "TRUST_RECORDS",
                    "TRUST_RECORD_BYTES",
                    "TRUST_REPORT_ENTRIES",
                    "TRUST_REPORT_HOOKS",
                    "UNACKNOWLEDGED_INPUT_CHUNKS",
                    "UNEXPECTED_DIAGNOSTIC_BYTES_PER_OPERATION",
                    "WEBVIEW2_VERSION_BYTES",
                    "WHOLE_FILE_STAGE_INPUT_BYTES",
                    "WINDOWS_COMMAND_LINE_UNITS",
                    "WORKTREE_LISTING_BYTES",
                    "WORKTREE_RECORDS",
                    "WSL_ANCHOR_LINE_INTERVAL_MS",
                    "WSL_DISTRO_START_MS",
                    "WSL_POLL_GAP_MS"
                  ]
                }
              },
              "required": [
                "state",
                "code"
              ],
              "additionalProperties": false,
              "title": "Limited"
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "failed"
                },
                "code": {
                  "type": "string",
                  "enum": [
                    "INVALID_REQUEST",
                    "PROTOCOL_VERSION",
                    "UNKNOWN_OPERATION",
                    "UNKNOWN_TARGET",
                    "FRAME_LIMIT",
                    "BUSY",
                    "WORKSPACE_LIMIT",
                    "GIT_UNAVAILABLE",
                    "GIT_CHANGED",
                    "GIT_UNSUPPORTED",
                    "WEBVIEW_UNAVAILABLE",
                    "WEBVIEW_UNSUPPORTED",
                    "WSL_UNAVAILABLE",
                    "REPOSITORY_UNAVAILABLE",
                    "REPOSITORY_CHANGED",
                    "UNSUPPORTED_REPOSITORY",
                    "OPERATION_IN_PROGRESS",
                    "CONFLICTED",
                    "LOCKED",
                    "UNSUPPORTED_SUBMODULE",
                    "TRUST_REQUIRED",
                    "TRUST_CHANGED",
                    "STALE_SELECTION",
                    "STALE_REVIEW",
                    "APPROVAL_EXPIRED",
                    "UNSUPPORTED_HUNK_PROFILE",
                    "MALFORMED_GIT_OUTPUT",
                    "OUTPUT_LIMIT",
                    "OBJECT_MISSING",
                    "UNSUPPORTED_COMPARISON",
                    "DISPLAY_MAPPING_FAILED",
                    "GRAPH_LAYOUT_LIMITED",
                    "WORKTREE_CHANGING",
                    "IDENTITY_REQUIRED",
                    "HOOK_FAILED",
                    "SIGNING_FAILED",
                    "GIT_FAILED",
                    "PROCESS_OWNERSHIP_FAILED",
                    "PICKER_FAILED",
                    "DEADLINE",
                    "CANCELED",
                    "COMMIT_ENCODING_UNSUPPORTED",
                    "COMPLETED_WITH_EFFECTS",
                    "FAILED_WITH_EFFECTS",
                    "STATE_UNKNOWN",
                    "SERVICE_UNAVAILABLE",
                    "RECOVERY_MARKER_FAILED",
                    "HISTORY_CHANGED",
                    "UNSUPPORTED_FILTER_TEXT",
                    "SEARCH_UNSUPPORTED",
                    "SYNC_UNAVAILABLE",
                    "PUSH_REJECTED",
                    "PUTTY_UNAVAILABLE",
                    "DESTINATION_NOT_EMPTY",
                    "WORKBENCH_UNAVAILABLE",
                    "UNTRACKED_IN_WAY",
                    "STASH_KEPT",
                    "BLAME_UNAVAILABLE",
                    "SUBMODULE_UNAVAILABLE",
                    "DICTIONARY_UNAVAILABLE",
                    "RELEASE_LINK_UNAVAILABLE",
                    "RELEASE_LINK_OPEN_FAILED"
                  ]
                }
              },
              "required": [
                "state",
                "code"
              ],
              "additionalProperties": false,
              "title": "Failed"
            }
          ],
          "title": "Completeness"
        },
        "cut": {
          "anyOf": [
            {
              "type": "string",
              "enum": [
                "untracked",
                "other"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "hunkEligibility": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "type": "object",
                  "properties": {
                    "eligible": {
                      "type": "boolean",
                      "const": true
                    }
                  },
                  "required": [
                    "eligible"
                  ],
                  "additionalProperties": false,
                  "title": "Eligible"
                },
                {
                  "type": "object",
                  "properties": {
                    "eligible": {
                      "type": "boolean",
                      "const": false
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "sparse-index",
                        "split-index",
                        "index-change-hook",
                        "executable-monitor",
                        "unqualified-monitor",
                        "shared-repository"
                      ]
                    }
                  },
                  "required": [
                    "eligible",
                    "reason"
                  ],
                  "additionalProperties": false,
                  "title": "Ineligible"
                }
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "location": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "native"
                }
              },
              "required": [
                "kind"
              ],
              "additionalProperties": false,
              "title": "NativeLocation"
            },
            {
              "type": "object",
              "properties": {
                "kind": {
                  "type": "string",
                  "const": "wsl"
                },
                "distro": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
                },
                "git": {
                  "type": "object",
                  "properties": {
                    "path": {
                      "type": "string",
                      "pattern": "^\\/[^\\u0000]*$"
                    },
                    "version": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\u0000]*$"
                    }
                  },
                  "required": [
                    "path",
                    "version"
                  ],
                  "additionalProperties": false
                }
              },
              "required": [
                "kind",
                "distro",
                "git"
              ],
              "additionalProperties": false,
              "title": "WslLocation"
            }
          ],
          "title": "WorkspaceLocation"
        },
        "submoduleNotice": {
          "type": "object",
          "properties": {
            "count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "paths": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "filter": {
              "type": "string",
              "enum": [
                "applied",
                "skipped"
              ]
            }
          },
          "required": [
            "count",
            "paths",
            "filter"
          ],
          "additionalProperties": false
        },
        "entryCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "entryId": {
                "type": "string",
                "maxLength": 64,
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "category": {
                "type": "string",
                "enum": [
                  "staged",
                  "unstaged",
                  "untracked",
                  "conflicted"
                ]
              },
              "path": {
                "type": "string"
              },
              "pathBytes": {
                "type": "string",
                "minLength": 1,
                "format": "base64",
                "contentEncoding": "base64",
                "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
              },
              "xy": {
                "type": "string",
                "pattern": "^[.MTADRCU]{2}$"
              },
              "submodule": {
                "type": "string",
                "pattern": "^(?:N\\.\\.\\.|S[C.][M.][U.])$"
              },
              "modes": {
                "minItems": 3,
                "maxItems": 4,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^[0-7]{6}$"
                }
              },
              "oids": {
                "minItems": 2,
                "maxItems": 3,
                "type": "array",
                "items": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              },
              "score": {
                "type": "string",
                "pattern": "^[RC][0-9]{1,3}$"
              },
              "sourcePath": {
                "type": "string"
              },
              "sourcePathBytes": {
                "type": "string",
                "minLength": 1,
                "format": "base64",
                "contentEncoding": "base64",
                "pattern": "^$|^(?:[0-9a-zA-Z+/]{4})*(?:(?:[0-9a-zA-Z+/]{2}==)|(?:[0-9a-zA-Z+/]{3}=))?$"
              },
              "flags": {
                "type": "object",
                "properties": {
                  "intentToAdd": {
                    "type": "boolean"
                  },
                  "assumeUnchanged": {
                    "type": "boolean"
                  },
                  "skipWorktree": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "intentToAdd",
                  "assumeUnchanged",
                  "skipWorktree"
                ],
                "additionalProperties": false
              }
            },
            "required": [
              "entryId",
              "category",
              "path",
              "pathBytes"
            ],
            "additionalProperties": false,
            "title": "ChangeEntry"
          }
        },
        "cursor": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "recovery": {
          "type": "object",
          "properties": {
            "outcome": {
              "type": "string",
              "enum": [
                "unknown",
                "none"
              ]
            },
            "attribution": {
              "oneOf": [
                {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "const": "identified"
                    },
                    "commitOid": {
                      "type": "string",
                      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                    }
                  },
                  "required": [
                    "result",
                    "commitOid"
                  ],
                  "additionalProperties": false,
                  "title": "AttributionIdentified"
                },
                {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "const": "none"
                    }
                  },
                  "required": [
                    "result"
                  ],
                  "additionalProperties": false,
                  "title": "AttributionNone"
                },
                {
                  "type": "object",
                  "properties": {
                    "result": {
                      "type": "string",
                      "const": "unknown"
                    },
                    "reason": {
                      "type": "string",
                      "enum": [
                        "ambiguous",
                        "evidence-limit",
                        "no-retained-request"
                      ]
                    }
                  },
                  "required": [
                    "result",
                    "reason"
                  ],
                  "additionalProperties": false,
                  "title": "AttributionUnknown"
                }
              ]
            },
            "indexMatch": {
              "type": "string",
              "enum": [
                "published",
                "not-published",
                "neither"
              ]
            },
            "submoduleResults": {
              "maxItems": 256,
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "rowId": {
                    "type": "string",
                    "maxLength": 64,
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
                  },
                  "path": {
                    "type": "string",
                    "pattern": "^[^\\u0000]*$"
                  },
                  "state": {
                    "type": "string",
                    "enum": [
                      "cloned",
                      "moved",
                      "unchanged",
                      "failed",
                      "clone-interrupted",
                      "changed-elsewhere",
                      "refused"
                    ]
                  },
                  "oldCommit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "newCommit": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "fetched": {
                    "type": "boolean"
                  },
                  "connected": {
                    "type": "boolean"
                  },
                  "found": {
                    "type": "boolean"
                  },
                  "registered": {
                    "type": "boolean"
                  },
                  "reason": {
                    "type": "string",
                    "enum": [
                      "unsaved-commits",
                      "update-mode",
                      "clone-interrupted",
                      "folder-not-empty",
                      "no-url",
                      "path",
                      "active-value",
                      "remote-name",
                      "parent-not-initialized",
                      "inactive",
                      "gitdir-config",
                      "limit",
                      "programs",
                      "changed-after-review"
                    ]
                  },
                  "text": {
                    "type": "string",
                    "pattern": "^[^\\u0000]*$"
                  },
                  "remedy": {
                    "type": "object",
                    "properties": {
                      "command": {
                        "anyOf": [
                          {
                            "type": "string",
                            "pattern": "^[^\\u0000]*$"
                          },
                          {
                            "type": "null"
                          }
                        ]
                      },
                      "text": {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      }
                    },
                    "required": [
                      "command"
                    ],
                    "additionalProperties": false
                  },
                  "outputTail": {
                    "type": "string",
                    "pattern": "^[^\\u0000]*$"
                  },
                  "exitCode": {
                    "anyOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 4294967295
                      },
                      {
                        "type": "null"
                      }
                    ]
                  },
                  "failedRead": {
                    "type": "string",
                    "enum": [
                      "check",
                      "remote-get-url",
                      "folder",
                      "clone-check",
                      "level",
                      "url"
