{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "snapshotId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "identity": {
          "type": "object",
          "properties": {
            "worktreeRoot": {
              "type": "string",
              "maxLength": 32767,
              "pattern": "^[^\\u0000]*$"
            },
            "gitDirectory": {
              "type": "string",
              "maxLength": 32767,
              "pattern": "^[^\\u0000]*$"
            },
            "commonDirectory": {
              "type": "string",
              "maxLength": 32767,
              "pattern": "^[^\\u0000]*$"
            },
            "indexPath": {
              "type": "string",
              "maxLength": 32767,
              "pattern": "^[^\\u0000]*$"
            },
            "objectFormat": {
              "type": "string",
              "enum": [
                "sha1",
                "sha256"
              ]
            },
            "refFormat": {
              "type": "string",
              "enum": [
                "files",
                "reftable"
              ]
            }
          },
          "required": [
            "worktreeRoot",
            "gitDirectory",
            "commonDirectory",
            "indexPath",
            "objectFormat",
            "refFormat"
          ],
          "additionalProperties": false
        },
        "head": {
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "branch"
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                },
                "oid": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              },
              "required": [
                "state",
                "target",
                "oid"
              ],
              "additionalProperties": false,
              "title": "BranchHead"
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "detached"
                },
                "oid": {
                  "type": "string",
                  "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                }
              },
              "required": [
                "state",
                "oid"
              ],
              "additionalProperties": false,
              "title": "DetachedHead"
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "unborn"
                },
                "target": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "state",
                "target"
              ],
              "additionalProperties": false,
              "title": "UnbornHead"
            }
          ],
          "title": "Head"
        },
        "operationState": {
          "type": "string",
          "enum": [
            "normal",
            "conflicted",
            "merging",
            "rebasing",
            "cherry-picking",
            "reverting",
            "sequencer-active",
            "unknown"
          ]
        },
        "recoveryState": {
          "type": "string",
          "enum": [
            "ready",
            "refreshing",
            "reconciling",
            "unknown",
            "unavailable"
          ]
        },
        "completeness": {
          "oneOf": [
            {
              "type": "object",
