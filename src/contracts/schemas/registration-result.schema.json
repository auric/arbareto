{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "repositoryId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "generation": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "worktreeKey": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "repositoryId",
        "generation",
        "worktreeKey"
      ],
      "additionalProperties": false,
      "title": "Registered"
    },
    {
      "type": "object",
      "properties": {
        "path": {
          "type": "string"
        },
        "remedy": {
          "type": "object",
          "properties": {
            "text": {
              "type": "string"
            },
            "command": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false
        },
        "outputTail": {
          "type": "string",
          "pattern": "^[^\\u0000]*$"
        }
      },
      "additionalProperties": false,
      "title": "RegistrationRefused"
    },
    {
      "type": "object",
      "properties": {
        "limit": {
          "type": "number",
          "const": 8
        }
      },
      "required": [
        "limit"
      ],
      "additionalProperties": false,
      "title": "WorkspaceLimit"
    }
  ],
  "title": "RegistrationResult"
}
