{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "language": {
          "type": "string",
          "maxLength": 32,
          "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
        },
        "removed": {
          "type": "boolean"
        }
      },
      "required": [
        "language",
        "removed"
      ],
      "additionalProperties": false,
      "title": "DictionaryRemoved"
    },
    {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "busy",
            "remove"
          ]
        },
        "status": {
          "type": "integer",
          "minimum": 100,
          "maximum": 599
        },
        "folder": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "url": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": [
        "reason"
      ],
      "additionalProperties": false,
      "title": "RemoveDictionaryRefusal"
    }
  ],
  "title": "RemoveDictionaryResult"
}
