{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "sessionId": {
      "type": "string",
      "maxLength": 64,
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "textScale": {
      "type": "number",
      "minimum": 1,
      "maximum": 2.25
    }
  },
  "required": [
    "sessionId",
    "textScale"
  ],
  "additionalProperties": false,
  "title": "SessionResult"
}
