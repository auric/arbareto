{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "action": {
      "type": "string",
      "enum": [
        "fetch",
        "fetch-all",
        "pull",
        "integrate",
        "push",
        "force-push",
        "abort",
        "continue",
        "skip"
      ]
    },
    "fetch": {
      "type": "object",
      "properties": {
        "remotes": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000]*$"
              },
              "state": {
                "type": "string",
                "enum": [
                  "succeeded",
                  "failed",
                  "canceled",
                  "deadline",
                  "not-started"
                ]
              },
              "updates": {
                "maxItems": 1000,
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "flag": {
                      "type": "string",
                      "enum": [
                        " ",
                        "+",
                        "-",
                        "t",
                        "*",
                        "!",
                        "="
                      ]
                    },
                    "oldObjectId": {
                      "type": "string",
                      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                    },
                    "newObjectId": {
                      "type": "string",
                      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                    },
                    "ref": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[^\\u0000]*$"
                    }
                  },
                  "required": [
                    "flag",
                    "oldObjectId",
                    "newObjectId",
                    "ref"
                  ],
                  "additionalProperties": false,
                  "title": "FetchUpdate"
                }
              },
              "counts": {
                "type": "object",
                "propertyNames": {
                  "type": "string",
                  "enum": [
                    " ",
                    "+",
                    "-",
                    "t",
                    "*",
                    "!",
                    "="
                  ]
                },
                "additionalProperties": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                },
                "required": [
                  " ",
                  "+",
                  "-",
                  "t",
                  "*",
                  "!",
                  "="
                ]
              },
              "outputTail": {
                "type": "string",
                "pattern": "^[^\\u0000]*$"
              }
            },
            "required": [
              "name",
              "state",
              "updates",
              "counts",
              "outputTail"
            ],
            "additionalProperties": false,
            "title": "FetchRemote"
          }
        },
        "observed": {
          "maxItems": 100000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "ref": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000]*$"
              },
              "oldObjectId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "newObjectId": {
                "anyOf": [
                  {
                    "type": "string",
                    "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "ref",
              "oldObjectId",
              "newObjectId"
            ],
            "additionalProperties": false,
            "title": "ObservedRef"
          }
        }
      },
      "required": [
        "remotes",
        "observed"
      ],
      "additionalProperties": false,
      "title": "FetchResult"
    },
    "push": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "pushed",
            "forced",
            "created",
            "up-to-date",
            "rejected",
            "remote-rejected",
            "remote-failure",
            "none"
          ]
        },
        "oldObjectId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "newObjectId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasonText": {
          "type": [
            "string",
            "null"
          ]
        },
        "lease": {
          "type": "boolean"
        },
        "upstreamWritten": {
          "type": "boolean"
        },
        "upstreamNotSet": {
          "type": "boolean"
        },
        "outputTail": {
          "type": "string",
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": [
        "status",
        "oldObjectId",
        "newObjectId",
        "reasonText",
        "lease",
        "upstreamWritten",
        "upstreamNotSet",
        "outputTail"
      ],
      "additionalProperties": false,
      "title": "PushResult"
    },
    "counts": {
      "type": "object",
      "properties": {
        "ahead": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "behind": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "ahead",
        "behind"
      ],
      "additionalProperties": false,
      "title": "SyncCounts"
    },
    "integration": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "none"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "title": "IntegrationNone"
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "up-to-date"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "title": "IntegrationUpToDate"
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "mode-required"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "title": "IntegrationModeRequired"
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "done"
            }
          },
          "required": [
            "state"
          ],
          "additionalProperties": false,
          "title": "IntegrationDone"
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "stopped"
            },
            "operation": {
              "type": "string",
              "enum": [
                "merging",
                "rebasing"
              ]
            },
            "unmerged": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "state",
            "operation",
            "unmerged"
          ],
          "additionalProperties": false,
          "title": "IntegrationStopped"
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "refused"
            },
            "outputTail": {
              "type": "string",
              "pattern": "^[^\\u0000]*$"
            }
          },
          "required": [
            "state",
            "outputTail"
          ],
          "additionalProperties": false,
          "title": "IntegrationRefused"
        }
      ],
      "title": "Integration"
    },
    "modeSource": {
      "anyOf": [
        {
          "type": "string",
          "enum": [
            "payload",
            "branch",
            "pull",
            "pull-ff"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "remedy": {
      "type": "object",
      "properties": {
        "text": {
          "type": "string",
          "minLength": 1
        },
        "command": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "text",
        "command"
      ],
      "additionalProperties": false,
      "title": "SyncRemedy"
    },
    "reason": {
      "type": "string",
      "enum": [
        "rejected",
        "stale-lease",
        "remote-rejected",
        "remote-failure",
        "missing",
        "unreadable",
        "version",
        "exit",
        "not-ready"
      ]
    },
    "program": {
      "type": "string",
      "enum": [
        "plink",
        "pageant",
        "puttygen"
      ]
    },
    "path": {
      "type": "string",
      "maxLength": 32767,
      "pattern": "^[^\\u0000]*$"
    }
  },
  "required": [
    "action"
  ],
  "additionalProperties": false,
  "title": "SyncResult"
}
