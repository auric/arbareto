{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "sshClient": {
          "type": "string",
          "enum": [
            "git",
            "plink"
          ]
        },
        "defaultPullAction": {
          "type": "string",
          "enum": [
            "pull",
            "pull-merge",
            "pull-rebase",
            "fetch",
            "fetch-all"
          ]
        },
        "switchChoice": {
          "type": "string",
          "enum": [
            "keep",
            "stash"
          ]
        },
        "plinkPath": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32767,
              "pattern": "^[^\\u0000]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "programs": {
          "maxItems": 3,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "program": {
                "type": "string",
                "enum": [
                  "plink",
                  "pageant",
                  "puttygen"
                ]
              },
              "path": {
                "type": "string",
                "maxLength": 32767,
                "pattern": "^[^\\u0000]*$"
              },
              "present": {
                "type": "boolean"
              }
            },
            "required": [
              "program",
              "path",
              "present"
            ],
            "additionalProperties": false,
            "title": "SyncProgram"
          }
        },
        "remoteKeyFiles": {
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "worktreeKey": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "remote": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[^\\u0000]*$"
              },
              "path": {
                "type": "string",
                "maxLength": 32767,
                "pattern": "^[^\\u0000]*$"
              }
            },
            "required": [
              "worktreeKey",
              "remote",
              "path"
            ],
            "additionalProperties": false,
            "title": "KeyFile"
          }
        },
        "defaultCloneFolder": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32767,
              "pattern": "^[^\\u0000]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "lastCloneParent": {
          "anyOf": [
            {
              "type": "string",
              "maxLength": 32767,
              "pattern": "^[^\\u0000]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "spelling": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "languages": {
              "maxItems": 3,
              "type": "array",
              "items": {
                "type": "string",
                "maxLength": 32,
                "pattern": "^[a-z]{2,3}(-[A-Za-z0-9]{2,8})*$"
              }
            }
          },
          "required": [
            "enabled",
            "languages"
          ],
          "additionalProperties": false,
          "title": "SpellingSetting"
        }
      },
      "required": [
        "sshClient",
        "defaultPullAction",
        "switchChoice",
        "plinkPath",
        "programs",
        "remoteKeyFiles",
        "defaultCloneFolder",
        "lastCloneParent",
        "spelling"
      ],
      "additionalProperties": false,
      "title": "SyncSettings"
    },
    {
      "type": "object",
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "missing",
            "unreadable",
            "version",
            "exit",
            "not-ready"
          ]
        },
        "program": {
          "type": "string",
          "enum": [
            "plink",
            "pageant",
            "puttygen"
          ]
        },
        "path": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        }
      },
      "required": [
        "reason",
        "program",
        "path"
      ],
      "additionalProperties": false,
      "title": "PuttyRefused"
    }
  ],
  "title": "SyncSettingsResult"
}
