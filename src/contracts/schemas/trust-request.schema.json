{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "confirm"
        },
        "worktreeRoot": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "gitDirectory": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "commonDirectory": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "gitSelectedPath": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "persist": {
          "type": "boolean"
        },
        "bound": {
          "type": "string",
          "enum": [
            "file-count",
            "file-bytes",
            "total-bytes"
          ]
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "worktreeRoot",
        "gitDirectory",
        "commonDirectory",
        "gitSelectedPath",
        "fingerprint",
        "persist",
        "callId"
      ],
      "additionalProperties": false,
      "title": "Confirm"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "revoke"
        },
        "commonDirectory": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "commonDirectory",
        "callId"
      ],
      "additionalProperties": false,
      "title": "Revoke"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "confirmRun"
        },
        "worktreeRoot": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "submodulePaths": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 32767,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "programCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "uncheckedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "worktreeRoot",
        "submodulePaths",
        "programCount",
        "uncheckedCount",
        "callId"
      ],
      "additionalProperties": false,
      "title": "ConfirmRun"
    }
  ],
  "title": "TrustRequest"
}
