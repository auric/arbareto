{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "confirm"
        },
        "worktreeRoot": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "adminDirectory": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "commonDirectory": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "gitSelectedPath": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "policyVersion": {
          "type": "number",
          "const": 2
        },
        "action": {
          "type": "string",
          "enum": [
            "commit",
            "read",
            "fetch",
            "pull",
            "push",
            "switch",
            "branch",
            "merge",
            "rebase",
            "resolve",
            "mergetool",
            "worktree",
            "submodules"
          ]
        },
        "details": {
          "type": "object",
          "properties": {
            "hooks": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "anyOf": [
                      {
                        "type": "object",
                        "properties": {
                          "event": {
                            "type": "string",
                            "pattern": "^[^\\u0000]*$"
                          },
                          "folder": {
                            "type": "string",
                            "pattern": "^[^\\u0000]*$"
                          }
                        },
                        "required": [
                          "event",
                          "folder"
                        ],
                        "additionalProperties": false,
                        "title": "FolderHookName"
                      },
                      {
                        "type": "object",
                        "properties": {
                          "event": {
                            "type": "string",
                            "pattern": "^[^\\u0000]*$"
                          },
                          "scope": {
                            "type": "string",
                            "enum": [
                              "system",
                              "global",
                              "local",
                              "worktree",
                              "command",
                              "submodule",
                              "unknown"
                            ]
                          }
                        },
                        "required": [
                          "event",
                          "scope"
                        ],
                        "additionalProperties": false,
                        "title": "ConfiguredHookName"
                      }
                    ]
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "filters": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "driver": {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "driver",
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "monitors": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "mergeDrivers": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "driver": {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "driver",
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "mergeTools": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "tool": {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "tool",
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "signing": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            },
            "other": {
              "type": "object",
              "properties": {
                "names": {
                  "maxItems": 20,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "key": {
                        "type": "string",
                        "pattern": "^[^\\u0000]*$"
                      },
                      "scope": {
                        "type": "string",
                        "enum": [
                          "system",
                          "global",
                          "local",
                          "worktree",
                          "command",
                          "submodule",
                          "unknown"
                        ]
                      }
                    },
                    "required": [
                      "key",
                      "scope"
                    ],
                    "additionalProperties": false
                  }
                },
                "more": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "names",
                "more"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "hooks",
            "filters",
            "monitors",
            "mergeDrivers",
            "mergeTools",
            "signing",
            "other"
          ],
          "additionalProperties": false,
          "title": "TrustDetails"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "worktreeRoot",
        "adminDirectory",
        "commonDirectory",
        "gitSelectedPath",
        "policyVersion",
        "action",
        "details",
        "callId"
      ],
      "additionalProperties": false,
      "title": "Confirm"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "revoke"
        },
        "commonDirectory": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "commonDirectory",
        "callId"
      ],
      "additionalProperties": false,
      "title": "Revoke"
    },
    {
      "type": "object",
      "properties": {
        "type": {
          "type": "string",
          "const": "confirmRun"
        },
        "worktreeRoot": {
          "type": "string",
          "maxLength": 32767,
          "pattern": "^[^\\u0000]*$"
        },
        "submodulePaths": {
          "minItems": 1,
          "maxItems": 256,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 32767,
            "pattern": "^[^\\u0000]*$"
          }
        },
        "programCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "uncheckedCount": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "callId": {
          "type": "string",
          "maxLength": 64,
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        }
      },
      "required": [
        "type",
        "worktreeRoot",
        "submodulePaths",
        "programCount",
        "uncheckedCount",
        "callId"
      ],
      "additionalProperties": false,
      "title": "ConfirmRun"
    }
  ],
  "title": "TrustRequest"
}
