{
  "wrapper": [
    "unit=$1 mode=$2 index=$3 run=$4 ctl=$5 setsid=$6",
    "shift 6",
    "end() { \"$ctl\" --user kill --signal=SIGKILL -- \"$unit\" >/dev/null 2>&1; }",
    "trap 'end; exit 129' HUP",
    "export GIT_TERMINAL_PROMPT=0",
    "case $mode in",
    "probe) export LC_ALL=C ;;",
    "read | mutation) ;;",
    "network) export GIT_PROTOCOL_FROM_USER=0 ;;",
    "*) exit 125 ;;",
    "esac",
    "[ -z \"$index\" ] || export GIT_INDEX_FILE=\"$index\"",
    "exec 3<&0",
    "\"$run\" --user --scope --quiet --collect --unit=\"$unit\" -- \"$setsid\" --wait \"$@\" <&3 3<&- &",
    "exec 3<&-",
    "wait $!",
    "status=$?",
    "case $mode in probe | read) end ;; esac",
    "exit $status"
  ],
  "anchor": [
    "ctl=$1 units=\"arbareto-$2-*.scope\"",
    "trap '\"$ctl\" --user kill --signal=SIGKILL -- \"$units\" >/dev/null 2>&1; exit 129' HUP",
    "report() {",
    "  count=0 io=0",
    "  for group in $(\"$ctl\" --user show --property=ControlGroup --value -- \"$units\" 2>/dev/null); do",
    "    [ -r \"/sys/fs/cgroup$group/cgroup.procs\" ] || continue",
    "    while read -r pid; do",
    "      count=$((count + 1))",
    "      [ -r \"/proc/$pid/io\" ] || continue",
    "      while read -r key value; do",
    "        case $key in rchar: | wchar:) io=$((io + value)) ;; esac",
    "      done <\"/proc/$pid/io\"",
    "    done <\"/sys/fs/cgroup$group/cgroup.procs\"",
    "  done",
    "  echo \"$count $io\"",
    "}",
    "while read -r line; do report; done",
    "while :; do",
    "  report",
    "  [ \"$count\" -eq 0 ] && exit 0",
    "  sleep 1",
    "done"
  ],
  "probe": [
    "export LC_ALL=C",
    "sel=$1",
    "found() {",
    "  p=$2",
    "  if [ -f \"$p\" ] && [ -x \"$p\" ]; then",
    "    printf 'path %s %s\\n' \"$1\" \"$p\"",
    "    case $(head -c 2 -- \"$p\" 2>/dev/null) in MZ) printf 'magic %s MZ\\n' \"$1\" ;; *) printf 'magic %s -\\n' \"$1\" ;; esac",
    "  else",
    "    printf 'absent %s\\n' \"$1\"",
    "    return 1",
    "  fi",
    "}",
    "resolve() {",
    "  p=$(command -v \"$1\") || p=",
    "  case $p in /*) p=$(readlink -f -- \"$p\") || p= ;; *) p= ;; esac",
    "  found \"$1\" \"$p\"",
    "}",
    "resolve git && git=$p || git=",
    "resolve systemd-run && run=$p || run=",
    "resolve systemctl && ctl=$p || ctl=",
    "resolve setsid",
    "found stat \"$(readlink -f -- /usr/bin/stat)\" && stat=$p || stat=",
    "found env \"$(readlink -f -- /usr/bin/env)\"",
    "found perl \"$(readlink -f -- /usr/bin/perl)\" && perl=$p || perl=",
    "printf 'pathenv %s\\n' \"$PATH\"",
    "if [ -r /etc/os-release ]; then",
    "  while IFS= read -r line || [ -n \"$line\" ]; do",
    "    case $line in ID=*) printf 'osid %s\\n' \"${line#ID=}\"; break ;; esac",
    "  done </etc/os-release",
    "fi",
    "if [ -n \"$git\" ]; then",
    "  printf 'version %s\\n' \"$(\"$git\" --version 2>/dev/null)\"",
    "  if [ -n \"$stat\" ]; then",
    "    printf 'gitfs %s\\n' \"$(\"$stat\" --dereference --file-system --format=%t:%i -- \"$git\" 2>/dev/null)\"",
    "    printf 'gitfile %s\\n' \"$(\"$stat\" --dereference --format=%i:%s:%Y -- \"$git\" 2>/dev/null)\"",
    "  fi",
    "fi",
    "if [ -n \"$stat\" ]; then",
    "  printf 'selfs %s\\n' \"$(\"$stat\" --dereference --file-system --format=%t:%i -- \"$sel\" 2>/dev/null)\"",
    "  printf 'selino %s\\n' \"$(\"$stat\" --dereference --format=%i -- \"$sel\" 2>/dev/null)\"",
    "fi",
    "if [ -n \"$perl\" ]; then",
    "  printf 'selstat %s\\n' \"$(\"$perl\" -e 'use POSIX qw(ENOENT ENOTDIR); print stat($ARGV[0]) ? q(ok) : $! == ENOENT || $! == ENOTDIR ? q(absent) : q(error)' -- \"$sel\" 2>/dev/null)\"",
    "fi",
    "if [ -n \"$run\" ] && [ -n \"$ctl\" ]; then",
    "  \"$run\" --user --scope --quiet --collect -- /bin/sh -c : >/dev/null 2>&1",
    "  printf 'scope %s\\n' \"$?\"",
    "fi"
  ],
  "identity": [
    "stat=$1 perl=$2",
    "shift 2",
    "for p in \"$@\"; do",
    "  if ino=$(\"$stat\" --dereference --format=%i -- \"$p\" 2>/dev/null) && fs=$(\"$stat\" --dereference --file-system --format=%t:%i -- \"$p\" 2>/dev/null); then",
    "    printf 'id %s %s\\n' \"$ino\" \"$fs\"",
    "  else",
    "    \"$perl\" -e 'use POSIX qw(ENOENT ENOTDIR); print stat($ARGV[0]) ? q(fail) : $! == ENOENT || $! == ENOTDIR ? q(absent) : q(fail)' -- \"$p\"",
    "    printf '\\n'",
    "  fi",
    "done"
  ],
  "fileFacts": [
    "use strict;",
    "use Fcntl qw(:mode O_RDONLY O_NONBLOCK O_NOCTTY O_NOFOLLOW O_DIRECTORY);",
    "use POSIX qw(EACCES EIO ENOENT ENOTDIR X_OK);",
    "binmode STDIN;",
    "binmode STDOUT;",
    "$/ = \"\\0\";",
    "my ($digest, @roots) = @ARGV;",
    "my ($fileBound, $totalBound, $total) = (1048576, 8388608, 0);",
    "sub take { my $v = <STDIN>; defined $v && chomp $v or exit 3; $v }",
    "sub put { print join(\"\\0\", @_), \"\\0\" }",
    "sub failed {",
    "  my ($at) = @_;",
    "  return put('absent') if $! == ENOENT || $! == ENOTDIR;",
    "  put('error', $at, $! == EACCES ? 'access-denied' : $! == EIO ? 'io-error' : 'other-error');",
    "}",
    "sub fact {",
    "  my ($root, @path) = @_;",
    "  my $dir;",
    "  sysopen($dir, $root, O_RDONLY | O_DIRECTORY) && chdir($dir) or return failed(0);",
    "  for my $at (1 .. @path) {",
    "    my $name = $path[$at - 1];",
    "    my @st = lstat($name) or return failed($at);",
    "    if (S_ISLNK($st[2])) {",
    "      my $target = readlink($name);",
    "      defined $target or return failed($at);",
    "      put('link', $at, length $target);",
    "      return print $target;",
    "    }",
    "    if ($at < @path) {",
    "      S_ISDIR($st[2]) or return put('absent');",
    "      my $next;",
    "      sysopen($next, $name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW) && chdir($next) or return failed($at);",
    "      next;",
    "    }",
    "    my $x = POSIX::access($name, X_OK) ? 1 : 0;",
    "    return put('directory', $x) if S_ISDIR($st[2]);",
    "    return put('other') unless S_ISREG($st[2]);",
    "    my $owner = $st[2] & S_IXUSR ? 1 : 0;",
    "    return put('file', $st[7], $st[9], $owner, $x, 'none') unless $digest;",
    "    sysopen(my $fh, $name, O_RDONLY | O_NONBLOCK | O_NOCTTY | O_NOFOLLOW) or return failed($at);",
    "    my @fs = stat($fh) or return failed($at);",
    "    return put(S_ISDIR($fs[2]) ? ('directory', $x) : 'other') unless S_ISREG($fs[2]);",
    "    my $data = '';",
    "    while (length $data <= $fileBound) {",
    "      my $n = sysread($fh, $data, $fileBound + 1 - length $data, length $data);",
    "      defined $n or return failed($at);",
    "      last if $n == 0;",
    "    }",
    "    return put('file', $fs[7], $fs[9], $owner, $x, 'file-bytes') if length $data > $fileBound;",
    "    return put('file', $fs[7], $fs[9], $owner, $x, 'total-bytes') if $total + length $data > $totalBound;",
    "    $total += length $data;",
    "    put('file', $fs[7], $fs[9], $owner, $x, 'data', length $data);",
    "    print $data;",
    "  }",
    "}",
    "while (defined(my $root = <STDIN>)) {",
    "  chomp $root or exit 3;",
    "  my $count = take();",
    "  fact($roots[$root], map { take() } 1 .. $count);",
    "}"
  ]
}
