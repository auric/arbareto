{
  "wrapper": [
    "unit=$1 mode=$2 index=$3 run=$4 ctl=$5 setsid=$6",
    "shift 6",
    "end() { \"$ctl\" --user kill --signal=SIGKILL -- \"$unit\" >/dev/null 2>&1; }",
    "trap 'end; exit 129' HUP",
    "export GIT_TERMINAL_PROMPT=0",
    "case $mode in",
    "probe) export LC_ALL=C ;;",
    "search) export LC_ALL=C.UTF-8 ;;",
    "read | mutation) ;;",
    "network) export GIT_PROTOCOL_FROM_USER=0 ;;",
    "*) exit 125 ;;",
    "esac",
    "[ -z \"$index\" ] || export GIT_INDEX_FILE=\"$index\"",
    "exec 3<&0",
    "\"$run\" --user --scope --quiet --collect --unit=\"$unit\" -- \"$setsid\" --wait \"$@\" <&3 3<&- &",
    "exec 3<&-",
    "wait $!",
    "status=$?",
    "case $mode in probe | read | search) end ;; esac",
    "exit $status"
  ],
  "anchor": [
    "ctl=$1 units=\"arbareto-$2-*.scope\"",
    "trap '\"$ctl\" --user kill --signal=SIGKILL -- \"$units\" >/dev/null 2>&1; exit 129' HUP",
    "report() {",
    "  count=0 sum=0",
    "  if groups=$(\"$ctl\" --user show --property=ControlGroup --value -- \"$units\" 2>/dev/null); then",
    "    for group in $groups; do",
    "      dir=/sys/fs/cgroup$group",
    "      if ! { while read -r pid; do count=$((count + 1)); done <\"$dir/cgroup.procs\"; } 2>/dev/null; then",
    "        [ -d \"$dir\" ] || continue",
    "        count=-",
    "        break",
    "      fi",
    "      usec=-",
    "      [ -r \"$dir/cpu.stat\" ] && while read -r key value; do",
    "        case $key:$value in usage_usec: | usage_usec:*[!0-9]*) ;; usage_usec:*) usec=$value ;; esac",
    "      done <\"$dir/cpu.stat\"",
    "      case $sum:$usec in -:* | *:-) sum=- ;; *) sum=$((sum + usec)) ;; esac",
    "    done",
    "  else",
    "    count=-",
    "  fi",
    "  [ \"$count\" = - ] && sum=-",
    "  echo \"$count $sum\"",
    "}",
    "while read -r line; do report; done",
    "while :; do",
    "  report",
    "  [ \"$count\" = 0 ] && exit 0",
    "  sleep 1",
    "done"
  ],
  "probe": [
    "export LC_ALL=C",
    "sel=$1",
    "found() {",
    "  p=$2",
    "  if [ -f \"$p\" ] && [ -x \"$p\" ]; then",
    "    printf 'path %s %s\\n' \"$1\" \"$p\"",
    "    case $(head -c 2 -- \"$p\" 2>/dev/null) in MZ) printf 'magic %s MZ\\n' \"$1\" ;; *) printf 'magic %s -\\n' \"$1\" ;; esac",
    "  else",
    "    printf 'absent %s\\n' \"$1\"",
    "    return 1",
    "  fi",
    "}",
    "resolve() {",
    "  p=$(command -v \"$1\") || p=",
    "  case $p in /*) p=$(readlink -f -- \"$p\") || p= ;; *) p= ;; esac",
    "  found \"$1\" \"$p\"",
    "}",
    "resolve git && git=$p || git=",
    "resolve systemd-run && run=$p || run=",
    "resolve systemctl && ctl=$p || ctl=",
    "resolve setsid",
    "found stat \"$(readlink -f -- /usr/bin/stat)\" && stat=$p || stat=",
    "found env \"$(readlink -f -- /usr/bin/env)\"",
    "found sha256sum \"$(readlink -f -- /usr/bin/sha256sum)\"",
    "found perl \"$(readlink -f -- /usr/bin/perl)\" && perl=$p || perl=",
    "printf 'pathenv %s\\n' \"$PATH\"",
    "if [ -r /etc/os-release ]; then",
    "  while IFS= read -r line || [ -n \"$line\" ]; do",
    "    case $line in ID=*) printf 'osid %s\\n' \"${line#ID=}\"; break ;; esac",
    "  done </etc/os-release",
    "fi",
    "if [ -n \"$git\" ]; then",
    "  printf 'version %s\\n' \"$(\"$git\" --version 2>/dev/null)\"",
    "  if [ -n \"$stat\" ]; then",
    "    printf 'gitfs %s\\n' \"$(\"$stat\" --dereference --file-system --format=%t:%i -- \"$git\" 2>/dev/null)\"",
    "    printf 'gitfile %s\\n' \"$(\"$stat\" --dereference --format=%i:%s:%Y -- \"$git\" 2>/dev/null)\"",
    "  fi",
    "fi",
    "if [ -n \"$stat\" ]; then",
    "  printf 'selfs %s\\n' \"$(\"$stat\" --dereference --file-system --format=%t:%i -- \"$sel\" 2>/dev/null)\"",
    "  printf 'selino %s\\n' \"$(\"$stat\" --dereference --format=%i -- \"$sel\" 2>/dev/null)\"",
    "fi",
    "if [ -n \"$perl\" ]; then",
    "  printf 'selstat %s\\n' \"$(\"$perl\" -e 'use POSIX qw(ENOENT ENOTDIR); print stat($ARGV[0]) ? q(ok) : $! == ENOENT || $! == ENOTDIR ? q(absent) : q(error)' -- \"$sel\" 2>/dev/null)\"",
    "fi",
    "if [ -n \"$run\" ] && [ -n \"$ctl\" ]; then",
    "  \"$run\" --user --scope --quiet --collect -- /bin/sh -c : >/dev/null 2>&1",
    "  printf 'scope %s\\n' \"$?\"",
    "fi"
  ],
  "identity": [
    "stat=$1 perl=$2",
    "shift 2",
    "for p in \"$@\"; do",
    "  if ino=$(\"$stat\" --dereference --format=%i -- \"$p\" 2>/dev/null) && fs=$(\"$stat\" --dereference --file-system --format=%t:%i -- \"$p\" 2>/dev/null); then",
    "    printf 'id %s %s\\n' \"$ino\" \"$fs\"",
    "  else",
    "    \"$perl\" -e 'use POSIX qw(ENOENT ENOTDIR); print stat($ARGV[0]) ? q(fail) : $! == ENOENT || $! == ENOTDIR ? q(absent) : q(fail)' -- \"$p\"",
    "    printf '\\n'",
    "  fi",
    "done"
  ],
  "matchingProbe": [
    "git=$1 dir=$2 tip=$3 count=$4",
    "shift 4",
    "[ \"$#\" -eq $((2 * count)) ] || exit 125",
    "mkdir -- \"$dir\" || exit 1",
    "trap 'rm -rf -- \"$dir\"' EXIT",
    "\"$git\" init --bare -q --template= --object-format=sha1 \"$dir\" || exit 1",
    "\"$git\" --git-dir=\"$dir\" fast-import --quiet || exit 1",
    "run() {",
    "  n=$1",
    "  shift",
    "  i=0",
    "  for a do",
    "    [ \"$i\" -ge \"$n\" ] || set -- \"$@\" \"$a\"",
    "    i=$((i + 1))",
    "  done",
    "  shift \"$i\"",
    "  printf '%s\\n' \"$tip\" | \"$git\" --git-dir=\"$dir\" \"$@\"",
    "  printf 'end %s\\n' \"$?\"",
    "}",
    "run \"$count\" \"$@\"",
    "shift \"$count\"",
    "run \"$count\" \"$@\""
  ],
  "perlHead": [
    "use strict;",
    "use Fcntl qw(:mode O_RDONLY O_WRONLY O_RDWR O_CREAT O_EXCL O_NONBLOCK O_NOCTTY O_NOFOLLOW O_DIRECTORY);",
    "use POSIX qw(EACCES EEXIST EIO ENOENT ENOTDIR X_OK);",
    "use IO::Handle;",
    "binmode STDIN;",
    "binmode STDOUT;",
    "$/ = \"\\0\";",
    "sub take { my $v = <STDIN>; defined $v && chomp $v or exit 3; $v }",
    "sub put { print join(\"\\0\", @_), \"\\0\" }",
    "sub code { my ($e) = @_; $e == EACCES ? 'access-denied' : $e == EIO ? 'io-error' : 'other-error' }",
    "sub failed {",
    "  my ($at) = @_;",
    "  return put('absent') if $! == ENOENT || $! == ENOTDIR;",
    "  put('error', $at, code($!));",
    "}",
    "sub writer {",
    "  my @command = @_;",
    "  pipe(my $r, my $w) or return;",
    "  my $pid = open(my $in, '|-');",
    "  return unless defined $pid;",
    "  if (!$pid) {",
    "    $SIG{PIPE} = 'DEFAULT';",
    "    open(STDOUT, '>&', $w) and exec { $command[0] } @command;",
    "    POSIX::_exit(127);",
    "  }",
    "  close $w;",
    "  ($in, $r);",
    "}",
    "sub ended {",
    "  my ($in, $r) = @_;",
    "  close $in;",
    "  my @status = $? == -1 ? () : $? & 127 ? ('signal', $? & 127) : ('exit', $? >> 8);",
    "  local $/;",
    "  my $text = defined $r ? <$r> : undef;",
    "  (\\@status, $text);",
    "}",
    "sub hex_of {",
    "  my ($status, $line) = @_;",
    "  \"@$status\" eq 'exit 0' && defined $line && $line =~ /\\A([0-9a-f]{64}) [ *]-\\n\\z/ ? $1 : undef;",
    "}",
    "sub pour {",
    "  my ($fh, $bound, @to) = @_;",
    "  my ($n, $buf, @dead) = (0);",
    "  while ($n <= $bound) {",
    "    my $want = $bound + 1 - $n;",
    "    my $got = sysread($fh, $buf, $want < 65536 ? $want : 65536);",
    "    return (undef, $! + 0) unless defined $got;",
    "    last unless $got;",
    "    $n += $got;",
    "    for my $i (0 .. $#to) {",
    "      my $at = 0;",
    "      while (!$dead[$i] && $at < $got) {",
    "        my $put = syswrite($to[$i], $buf, $got - $at, $at);",
    "        defined $put ? ($at += $put) : ($dead[$i] = $! + 0);",
    "      }",
    "    }",
    "  }",
    "  ($n, 0, @dead);",
    "}",
    "sub part {",
    "  my ($sha, $name, $bound) = @_;",
    "  sysopen(my $fh, $name, O_RDONLY | O_NONBLOCK | O_NOCTTY | O_NOFOLLOW) or return $! == ENOENT ? ('absent') : ('error', code($!));",
    "  my @fs = stat($fh) or return ('error', code($!));",
    "  S_ISREG($fs[2]) or return ('error', 'other-error');",
    "  my @hash = writer($sha, '-') or return ('error', 'other-error');",
    "  my ($n, $err) = pour($fh, $bound, $hash[0]);",
    "  my $hex = hex_of(ended(@hash));",
    "  return ('error', code($err)) unless defined $n;",
    "  return ('bound') if $n > $bound;",
    "  defined $hex ? ('digest', $n, $hex) : ('error', 'other-error');",
    "}",
    "sub digests {",
    "  my ($sha, $bound, $shared) = @_;",
    "  my @index = part($sha, 'index', $bound);",
    "  return ('index', @index) unless defined $shared;",
    "  my $left = $index[0] eq 'digest' ? $bound - $index[1] : $index[0] eq 'bound' ? -1 : $bound;",
    "  ('index', @index, $left < 0 ? ('bound') : part($sha, \"sharedindex.$shared\", $left));",
    "}"
  ],
  "fileFacts": [
    "my ($digest, @roots) = @ARGV;",
    "my ($sha, $shared) = splice(@roots, 3);",
    "my ($fileBound, $totalBound, $total) = (1048576, 8388608, 0);",
    "sub fact {",
    "  my ($root, @path) = @_;",
    "  my $dir;",
    "  sysopen($dir, $root, O_RDONLY | O_DIRECTORY) && chdir($dir) or return failed(0);",
    "  for my $at (1 .. @path) {",
    "    my $name = $path[$at - 1];",
    "    my @st = lstat($name) or return failed($at);",
    "    if (S_ISLNK($st[2])) {",
    "      my $target = readlink($name);",
    "      defined $target or return failed($at);",
    "      put('link', $at, length $target);",
    "      return print $target;",
    "    }",
    "    if ($at < @path) {",
    "      S_ISDIR($st[2]) or return put('absent');",
    "      my $next;",
    "      sysopen($next, $name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW) && chdir($next) or return failed($at);",
    "      next;",
    "    }",
    "    my $x = POSIX::access($name, X_OK) ? 1 : 0;",
    "    return put('directory', $x) if S_ISDIR($st[2]);",
    "    return put('other') unless S_ISREG($st[2]);",
    "    my $owner = $st[2] & S_IXUSR ? 1 : 0;",
    "    return put('file', $st[7], $st[9], $owner, $x, 'none') unless $digest;",
    "    sysopen(my $fh, $name, O_RDONLY | O_NONBLOCK | O_NOCTTY | O_NOFOLLOW) or return failed($at);",
    "    my @fs = stat($fh) or return failed($at);",
    "    return put(S_ISDIR($fs[2]) ? ('directory', $x) : 'other') unless S_ISREG($fs[2]);",
    "    my $data = '';",
    "    while (length $data <= $fileBound) {",
    "      my $n = sysread($fh, $data, $fileBound + 1 - length $data, length $data);",
    "      defined $n or return failed($at);",
    "      last if $n == 0;",
    "    }",
    "    return put('file', $fs[7], $fs[9], $owner, $x, 'file-bytes') if length $data > $fileBound;",
    "    return put('file', $fs[7], $fs[9], $owner, $x, 'total-bytes') if $total + length $data > $totalBound;",
    "    $total += length $data;",
    "    put('file', $fs[7], $fs[9], $owner, $x, 'data', length $data);",
    "    print $data;",
    "  }",
    "}",
    "while (defined(my $root = <STDIN>)) {",
    "  chomp $root or exit 3;",
    "  my $count = take();",
    "  fact($roots[$root], map { take() } 1 .. $count);",
    "}",
    "exit 0 unless defined $sha;",
    "$SIG{PIPE} = 'IGNORE';",
    "my $dir;",
    "sysopen($dir, $roots[1], O_RDONLY | O_DIRECTORY) && chdir($dir) or exit !put('error', 0, code($!));",
    "put(digests($sha, 67108864, $shared));"
  ],
  "wslFiles": [
    "$SIG{PIPE} = 'IGNORE';",
    "my ($mode, @roots) = @ARGV;",
    "my ($git, $sha) = splice(@roots, 3);",
    "sub entry {",
    "  my ($root, @path) = @_;",
    "  my $dir;",
    "  sysopen($dir, $roots[$root], O_RDONLY | O_DIRECTORY) && chdir($dir) or return failed(0);",
    "  for my $at (1 .. @path) {",
    "    my $name = $path[$at - 1];",
    "    my @st = lstat($name) or return failed($at);",
    "    if (S_ISLNK($st[2])) {",
    "      my $target = readlink($name);",
    "      defined $target or return failed($at);",
    "      put('link', $at, length $target);",
    "      return print $target;",
    "    }",
    "    if ($at < @path) {",
    "      S_ISDIR($st[2]) or return put('absent');",
    "      my $next;",
    "      sysopen($next, $name, O_RDONLY | O_DIRECTORY | O_NOFOLLOW) && chdir($next) or return failed($at);",
    "      next;",
    "    }",
    "    return put('directory') if S_ISDIR($st[2]);",
    "    return put('other') unless S_ISREG($st[2]);",
    "    sysopen(my $fh, $name, O_RDONLY | O_NONBLOCK | O_NOCTTY | O_NOFOLLOW) or return failed($at);",
    "    my @fs = stat($fh) or return failed($at);",
    "    return put(S_ISDIR($fs[2]) ? 'directory' : 'other') unless S_ISREG($fs[2]);",
    "    return ($fh, $st[0] == $fs[0] && $st[1] == $fs[1] ? 0 : 1, $at);",
    "  }",
    "}",
    "sub request { my $root = take(); my $count = take(); ($root, map { take() } 1 .. $count) }",
    "sub digest {",
    "  my ($bound, @request) = @_;",
    "  my ($fh, $changed, $at) = entry(@request);",
    "  return unless defined $at;",
    "  my @hash = writer($sha, '-') or return put('error', $at, 'other-error');",
    "  my ($n, $err) = pour($fh, $bound, $hash[0]);",
    "  my $hex = hex_of(ended(@hash));",
    "  return put('error', $at, code($err)) unless defined $n;",
    "  return put('file', $n, $changed, 'bound') if $n > $bound;",
    "  defined $hex ? put('file', $n, $changed, 'sha256', $hex) : put('error', $at, 'other-error');",
    "}",
    "sub in_git_dir { my $dir; sysopen($dir, $roots[1], O_RDONLY | O_DIRECTORY) && chdir($dir) or return !put('error', 0, code($!)); 1 }",
    "sub restore { my ($lock, $token) = @_; truncate($lock, 0) && sysseek($lock, 0, 0) && (syswrite($lock, $token) // -1) == length $token }",
    "sub undo { my $e = $! + 0; restore(@_); $e }",
    "sub same { my ($name, @fs) = @_; my @now = lstat($name) or return $! == ENOENT ? 0 : undef; $now[0] == $fs[0] && $now[1] == $fs[1] ? 1 : 0 }",
    "my %modes = (",
    "  digest => sub {",
    "    my ($bound) = @_;",
    "    while (defined(my $root = <STDIN>)) {",
    "      chomp $root or exit 3;",
    "      my $count = take();",
    "      digest($bound, $root, map { take() } 1 .. $count);",
    "    }",
    "  },",
    "  indexDigest => sub {",
    "    my ($bound) = @_;",
    "    my $shared = <STDIN>;",
    "    defined $shared and (chomp $shared or exit 3);",
    "    in_git_dir() or return;",
    "    put(digests($sha, $bound, $shared));",
    "  },",
    "  hashObject => sub {",
    "    my ($bound) = @_;",
    "    my ($root, @path) = request();",
    "    my ($fh, $changed, $at) = entry($root, @path);",
    "    return unless defined $at;",
    "    my @hash = writer($sha, '-') or return put('error', $at, 'other-error');",
    "    my @git = writer($git, '--no-lazy-fetch', '-C', $roots[0], 'hash-object', '--stdin', '--path=' . join('/', @path)) or return put('error', $at, 'other-error');",
    "    my ($n, $err) = pour($fh, $bound, $hash[0], $git[0]);",
    "    my ($git_exit, $oid) = ended(@git);",
    "    my ($hash_exit, $line) = ended(@hash);",
    "    return put('error', $at, code($err)) unless defined $n;",
    "    return put('file', $n, $changed, 'bound') if $n > $bound;",
    "    my $hex = hex_of($hash_exit, $line);",
    "    defined $hex && @$git_exit && @$hash_exit or return put('error', $at, 'other-error');",
    "    $oid = defined $oid && $oid =~ /\\A([0-9a-f]{40}|[0-9a-f]{64})\\n\\z/ ? $1 : 'none';",
    "    put('object', $n, $hex, $oid, @$git_exit, @$hash_exit);",
    "  },",
    "  catFile => sub {",
    "    my ($bound) = @_;",
    "    my ($root, @path) = request();",
    "    my ($oid, $size) = (take(), take());",
    "    my $pid = open(my $out, '-|');",
    "    defined $pid or return put('error', 0, 'other-error');",
    "    if (!$pid) {",
    "      $SIG{PIPE} = 'DEFAULT';",
    "      open(STDIN, '<', '/dev/null') and exec { $git } $git, '--no-lazy-fetch', '-C', $roots[0], 'cat-file', '--filters', '--path=' . join('/', @path), $oid;",
    "      POSIX::_exit(127);",
    "    }",
    "    my @hash = writer($sha, '-') or return put('error', 0, 'other-error');",
    "    my ($n, $err) = pour($out, $size, $hash[0]);",
    "    my ($git_exit) = ended($out);",
    "    my ($hash_exit, $line) = ended(@hash);",
    "    my $hex = hex_of($hash_exit, $line);",
    "    defined $n && defined $hex && @$git_exit or return put('error', 0, 'other-error');",
    "    put('blob', $n, $hex, $n > $size ? 1 : 0, @$git_exit, @$hash_exit);",
    "  },",
    "  lock => sub {",
    "    my $token = take();",
    "    in_git_dir() or return;",
    "    sysopen(my $lock, 'index.lock', O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0666) or return $! == EEXIST ? put('locked') : put('error', 0, code($!));",
    "    (syswrite($lock, $token) // -1) == length $token or return put('error', 0, code($!));",
    "    my @st = stat($lock) or return put('error', 0, code($!));",
    "    put('lock', $st[0], $st[1]);",
    "  },",
    "  candidate => sub {",
    "    my ($bound) = @_;",
    "    my $name = take();",
    "    in_git_dir() or return;",
    "    sysopen(my $index, 'index', O_RDONLY | O_NONBLOCK | O_NOCTTY | O_NOFOLLOW) or return $! == ENOENT ? put('absent') : put('error', 0, code($!));",
    "    my @is = stat($index) or return put('error', 0, code($!));",
    "    S_ISREG($is[2]) or return put('error', 0, 'other-error');",
    "    return put('bound') if $is[7] > $bound;",
    "    sysopen(my $copy, $name, O_WRONLY | O_CREAT | O_EXCL | O_NOFOLLOW, 0666) or return put('error', 0, code($!));",
    "    my @hash = writer($sha, '-') or return put('error', 0, 'other-error');",
    "    my ($n, $err, undef, $lost) = pour($index, $bound, $hash[0], $copy);",
    "    my $hex = hex_of(ended(@hash));",
    "    defined $n && !$lost or return put('error', 0, code($err || $lost));",
    "    return put('bound') if $n > $bound;",
    "    defined $hex or return put('error', 0, 'other-error');",
    "    utime($is[9], $is[9], $copy) && close($copy) or return put('error', 0, code($!));",
    "    sysopen(my $back, $name, O_RDONLY | O_NONBLOCK | O_NOCTTY | O_NOFOLLOW) or return put('error', 0, code($!));",
    "    my @cs = stat($back) or return put('error', 0, code($!));",
    "    @hash = writer($sha, '-') or return put('error', 0, 'other-error');",
    "    my ($m, $merr) = pour($back, $bound, $hash[0]);",
    "    my $chex = hex_of(ended(@hash));",
    "    defined $m && $m <= $bound && defined $chex or return put('error', 0, code($merr || 0));",
    "    put('candidate', $n, $hex, $is[9], $m, $chex, $cs[9]);",
    "  },",
    "  publish => sub {",
    "    my ($bound) = @_;",
    "    my ($name, $device, $inode, $token, $expected) = map { take() } 1 .. 5;",
    "    in_git_dir() or return;",
    "    sysopen(my $lock, 'index.lock', O_RDWR | O_NOFOLLOW | O_NONBLOCK | O_NOCTTY) or return $! == ENOENT ? put('notOwned') : put('error', 0, code($!));",
    "    my @ls = stat($lock) or return put('error', 0, code($!));",
    "    return put('notOwned') unless S_ISREG($ls[2]) && \"$ls[0]\" eq $device && \"$ls[1]\" eq $inode && $ls[7] == length $token;",
    "    my $found = '';",
    "    defined sysread($lock, $found, length($token) + 1) or return put('error', 0, code($!));",
    "    return put('notOwned') unless $found eq $token;",
    "    sysopen(my $candidate, $name, O_RDONLY | O_NONBLOCK | O_NOCTTY | O_NOFOLLOW) or return put('error', 0, code($!));",
    "    my @cs = stat($candidate) or return put('error', 0, code($!));",
    "    S_ISREG($cs[2]) && $cs[7] <= $bound or return put('error', 0, 'other-error');",
    "    my @hash = writer($sha, '-') or return put('error', 0, 'other-error');",
    "    truncate($lock, 0) && sysseek($lock, 0, 0) or return put('error', 0, code($!));",
    "    my ($n, $err, undef, $lost) = pour($candidate, $bound, $hash[0], $lock);",
    "    my $hex = hex_of(ended(@hash));",
    "    my $failure = !defined $n ? $err : $lost ? $lost : $n > $bound || !defined $hex ? 0 : utime($cs[9], $cs[9], $lock) ? undef : $! + 0;",
    "    if (defined $failure || $hex ne $expected) {",
    "      restore($lock, $token) or return put('error', 0, code($!));",
    "      return defined $failure ? put('error', 0, code($failure)) : put('mismatch');",
    "    }",
    "    $lock->sync or return put('error', 0, code(undo($lock, $token)));",
    "    my $same = same('index.lock', @ls);",
    "    defined $same or return put('error', 0, code(undo($lock, $token)));",
    "    unless ($same) {",
    "      restore($lock, $token);",
    "      return put('notOwned');",
    "    }",
    "    rename('index.lock', 'index') or return put('error', 0, code(undo($lock, $token)));",
    "    my $dir;",
    "    sysopen($dir, '.', O_RDONLY | O_DIRECTORY) && $dir->sync or return put('error', 0, code($!));",
    "    put('published', $n, $hex);",
    "  },",
    "  remove => sub {",
    "    my ($bound) = @_;",
    "    my $name = take();",
    "    my ($device, $inode) = $name eq 'index.lock' ? (take(), take()) : ();",
    "    my $check = take();",
    "    in_git_dir() or return;",
    "    sysopen(my $fh, $name, O_RDONLY | O_NOFOLLOW | O_NONBLOCK | O_NOCTTY) or return $! == ENOENT ? put('notOwned') : put('error', 0, code($!));",
    "    my @fs = stat($fh) or return put('error', 0, code($!));",
    "    S_ISREG($fs[2]) or return put('error', 0, 'other-error');",
    "    if ($name eq 'index.lock') {",
    "      return put('notOwned') unless ($device eq '' && $inode eq '' || \"$fs[0]\" eq $device && \"$fs[1]\" eq $inode) && $fs[7] == length $check;",
    "      my $found = '';",
    "      defined sysread($fh, $found, length($check) + 1) or return put('error', 0, code($!));",
    "      return put('notOwned') unless $found eq $check;",
    "    } else {",
    "      my @hash = writer($sha, '-') or return put('error', 0, 'other-error');",
    "      my ($n, $err) = pour($fh, $bound, $hash[0]);",
    "      my $hex = hex_of(ended(@hash));",
    "      defined $n or return put('error', 0, code($err));",
    "      return put('notOwned') if $n > $bound;",
    "      defined $hex or return put('error', 0, 'other-error');",
    "      return put('notOwned') unless $hex eq $check;",
    "    }",
    "    my $same = same($name, @fs);",
    "    defined $same or return put('error', 0, code($!));",
    "    $same or return put('notOwned');",
    "    unlink($name) or return put('error', 0, code($!));",
    "    put('removed');",
    "  },",
    ");",
    "my $run = $modes{$mode} or exit 3;",
    "$run->(take());"
  ]
}
